# Copy to .env and fill in what you use. TEST / SANDBOX keys only: never live keys.
# .env is gitignored; never commit it. Commands read it via `uv run --env-file .env ...`.

# --- LLM (the agent). Free tiers work: pick one provider. ---
# groq | gemini | openrouter | ollama (local, no key)
PAYWEAVE_LLM_PROVIDER=groq
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model override per provider; a,b,c moves on when one's daily quota is used up
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash

# --- Razorpay (Dashboard > Test Mode > API Keys) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Comma-separated, for webhook verification
RAZORPAY_WEBHOOK_SECRETS=

# --- Cashfree (sandbox dashboard > Developers > API Keys) ---
# The package's credential names: key_id = the App ID, key_secret = the Secret Key.
CASHFREE_KEY_ID=
CASHFREE_KEY_SECRET=

# --- Sandbox smoke test (gate G6) for gateways that need a customer on every order ---
# Your own test values; PayWeave never makes these up.
PAYWEAVE_TEST_CUSTOMER_ID=
PAYWEAVE_TEST_CUSTOMER_PHONE=

# --- Local services (defaults shown) ---
# Postgres + pgvector, for the knowledge base
# PAYWEAVE_DATABASE_URL=postgresql:///payweave
# Your private signing keys (never in the repo)
# PAYWEAVE_KEY_DIR=~/.config/payweave/keys
# Embedding model downloads
# PAYWEAVE_MODEL_CACHE=~/.cache/payweave
